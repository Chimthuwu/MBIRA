#pragma once
// Embedded shipped instruments (no filesystem access needed in a DAW-hosted
// plugin). Generated by CMake configure_file from src/instruments/*.json.
inline const char* getMbiraDzaJson() {
  return R"MBIRAJSON(
@MBIRA_DZA_CONTENT@
)MBIRAJSON";
}
inline const char* getMbiraNyungaJson() {
  return R"MBIRAJSON(
@MBIRA_NYUNGA_CONTENT@
)MBIRAJSON";
}
